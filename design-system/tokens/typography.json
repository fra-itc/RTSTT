{
  "$schema": "https://tr.designtokens.org/format/schema.json",
  "frisco-whisper-rtx": {
    "typography": {
      "fontFamilies": {
        "primary": {
          "$type": "fontFamily",
          "$value": ["Inter", "system-ui", "-apple-system", "sans-serif"],
          "$description": "Primary UI font - Clean and readable"
        },
        "mono": {
          "$type": "fontFamily",
          "$value": ["JetBrains Mono", "Cascadia Code", "Consolas", "monospace"],
          "$description": "Monospace font for code, logs, and technical data"
        },
        "display": {
          "$type": "fontFamily",
          "$value": ["Orbitron", "Russo One", "sans-serif"],
          "$description": "Display font for headers - Tech/gaming aesthetic"
        }
      },
      "fontSizes": {
        "xs": {
          "$type": "dimension",
          "$value": "0.75rem",
          "$description": "12px - Smallest text (captions, labels)"
        },
        "sm": {
          "$type": "dimension",
          "$value": "0.875rem",
          "$description": "14px - Small text (secondary info)"
        },
        "base": {
          "$type": "dimension",
          "$value": "1rem",
          "$description": "16px - Body text default"
        },
        "lg": {
          "$type": "dimension",
          "$value": "1.125rem",
          "$description": "18px - Large body text"
        },
        "xl": {
          "$type": "dimension",
          "$value": "1.25rem",
          "$description": "20px - Subheadings"
        },
        "2xl": {
          "$type": "dimension",
          "$value": "1.5rem",
          "$description": "24px - Section headers"
        },
        "3xl": {
          "$type": "dimension",
          "$value": "2rem",
          "$description": "32px - Page headers"
        },
        "4xl": {
          "$type": "dimension",
          "$value": "2.5rem",
          "$description": "40px - Hero text"
        },
        "5xl": {
          "$type": "dimension",
          "$value": "3rem",
          "$description": "48px - Display text"
        }
      },
      "fontWeights": {
        "light": {
          "$type": "number",
          "$value": 300,
          "$description": "Light weight"
        },
        "regular": {
          "$type": "number",
          "$value": 400,
          "$description": "Regular weight - Default body text"
        },
        "medium": {
          "$type": "number",
          "$value": 500,
          "$description": "Medium weight - Emphasis"
        },
        "semibold": {
          "$type": "number",
          "$value": 600,
          "$description": "Semibold - Strong emphasis"
        },
        "bold": {
          "$type": "number",
          "$value": 700,
          "$description": "Bold - Headers"
        },
        "black": {
          "$type": "number",
          "$value": 900,
          "$description": "Black - Maximum emphasis"
        }
      },
      "lineHeights": {
        "tight": {
          "$type": "number",
          "$value": 1.25,
          "$description": "Tight line height for headings"
        },
        "normal": {
          "$type": "number",
          "$value": 1.5,
          "$description": "Normal line height for body text"
        },
        "relaxed": {
          "$type": "number",
          "$value": 1.75,
          "$description": "Relaxed line height for readability"
        }
      },
      "letterSpacing": {
        "tighter": {
          "$type": "dimension",
          "$value": "-0.05em",
          "$description": "Tighter tracking"
        },
        "tight": {
          "$type": "dimension",
          "$value": "-0.025em",
          "$description": "Tight tracking"
        },
        "normal": {
          "$type": "dimension",
          "$value": "0",
          "$description": "Normal tracking"
        },
        "wide": {
          "$type": "dimension",
          "$value": "0.025em",
          "$description": "Wide tracking"
        },
        "wider": {
          "$type": "dimension",
          "$value": "0.05em",
          "$description": "Wider tracking - Display text"
        },
        "widest": {
          "$type": "dimension",
          "$value": "0.1em",
          "$description": "Widest tracking - All caps"
        }
      }
    }
  }
}
