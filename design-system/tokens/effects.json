{
  "$schema": "https://tr.designtokens.org/format/schema.json",
  "frisco-whisper-rtx": {
    "effects": {
      "transitions": {
        "fast": {
          "$type": "duration",
          "$value": "150ms",
          "$description": "Fast transition - Micro-interactions"
        },
        "base": {
          "$type": "duration",
          "$value": "250ms",
          "$description": "Base transition - Default animations"
        },
        "slow": {
          "$type": "duration",
          "$value": "350ms",
          "$description": "Slow transition - Complex animations"
        },
        "slower": {
          "$type": "duration",
          "$value": "500ms",
          "$description": "Slower transition - Page transitions"
        }
      },
      "easings": {
        "linear": {
          "$type": "cubicBezier",
          "$value": [0, 0, 1, 1],
          "$description": "Linear easing"
        },
        "ease": {
          "$type": "cubicBezier",
          "$value": [0.25, 0.1, 0.25, 1],
          "$description": "Default ease"
        },
        "ease-in": {
          "$type": "cubicBezier",
          "$value": [0.42, 0, 1, 1],
          "$description": "Ease in - Accelerating"
        },
        "ease-out": {
          "$type": "cubicBezier",
          "$value": [0, 0, 0.58, 1],
          "$description": "Ease out - Decelerating"
        },
        "ease-in-out": {
          "$type": "cubicBezier",
          "$value": [0.42, 0, 0.58, 1],
          "$description": "Ease in-out - Smooth"
        },
        "smooth": {
          "$type": "cubicBezier",
          "$value": [0.4, 0, 0.2, 1],
          "$description": "Smooth - Material Design"
        },
        "bounce": {
          "$type": "cubicBezier",
          "$value": [0.68, -0.55, 0.265, 1.55],
          "$description": "Bounce - Playful"
        }
      },
      "animations": {
        "pulse": {
          "$type": "string",
          "$value": "pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite",
          "$description": "Pulse animation - Status indicators"
        },
        "pulse-slow": {
          "$type": "string",
          "$value": "pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite",
          "$description": "Slow pulse - Subtle indicators"
        },
        "glow": {
          "$type": "string",
          "$value": "glow 2s ease-in-out infinite",
          "$description": "Glow animation - Neon effects"
        },
        "scan": {
          "$type": "string",
          "$value": "scan-line 4s linear infinite",
          "$description": "Scan line - Processing indicators"
        },
        "spin": {
          "$type": "string",
          "$value": "spin 1s linear infinite",
          "$description": "Spin - Loading indicators"
        },
        "fade-in": {
          "$type": "string",
          "$value": "fade-in 0.3s ease-out",
          "$description": "Fade in - Entrance animation"
        },
        "slide-up": {
          "$type": "string",
          "$value": "slide-up 0.3s ease-out",
          "$description": "Slide up - Modal entrance"
        }
      },
      "blur": {
        "none": {
          "$type": "dimension",
          "$value": "0",
          "$description": "No blur"
        },
        "sm": {
          "$type": "dimension",
          "$value": "4px",
          "$description": "Small blur - Subtle backdrop"
        },
        "base": {
          "$type": "dimension",
          "$value": "8px",
          "$description": "Base blur - Glassmorphism"
        },
        "md": {
          "$type": "dimension",
          "$value": "12px",
          "$description": "Medium blur - Strong glass effect"
        },
        "lg": {
          "$type": "dimension",
          "$value": "16px",
          "$description": "Large blur - Heavy backdrop"
        },
        "xl": {
          "$type": "dimension",
          "$value": "24px",
          "$description": "Extra large blur - Maximum effect"
        }
      },
      "opacity": {
        "0": {
          "$type": "number",
          "$value": 0,
          "$description": "Fully transparent"
        },
        "5": {
          "$type": "number",
          "$value": 0.05,
          "$description": "Nearly transparent"
        },
        "10": {
          "$type": "number",
          "$value": 0.1,
          "$description": "Very transparent"
        },
        "20": {
          "$type": "number",
          "$value": 0.2,
          "$description": "Transparent"
        },
        "30": {
          "$type": "number",
          "$value": 0.3,
          "$description": "Semi-transparent"
        },
        "40": {
          "$type": "number",
          "$value": 0.4,
          "$description": "Moderate transparency"
        },
        "50": {
          "$type": "number",
          "$value": 0.5,
          "$description": "Half transparent"
        },
        "60": {
          "$type": "number",
          "$value": 0.6,
          "$description": "Moderate opacity"
        },
        "70": {
          "$type": "number",
          "$value": 0.7,
          "$description": "Semi-opaque"
        },
        "80": {
          "$type": "number",
          "$value": 0.8,
          "$description": "Mostly opaque"
        },
        "90": {
          "$type": "number",
          "$value": 0.9,
          "$description": "Nearly opaque"
        },
        "100": {
          "$type": "number",
          "$value": 1,
          "$description": "Fully opaque"
        }
      }
    }
  }
}
