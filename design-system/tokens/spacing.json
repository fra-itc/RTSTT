{
  "$schema": "https://tr.designtokens.org/format/schema.json",
  "frisco-whisper-rtx": {
    "spacing": {
      "0": {
        "$type": "dimension",
        "$value": "0",
        "$description": "No spacing"
      },
      "1": {
        "$type": "dimension",
        "$value": "0.25rem",
        "$description": "4px - Minimal spacing"
      },
      "2": {
        "$type": "dimension",
        "$value": "0.5rem",
        "$description": "8px - Tight spacing"
      },
      "3": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$description": "12px - Small spacing"
      },
      "4": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "16px - Base spacing"
      },
      "5": {
        "$type": "dimension",
        "$value": "1.25rem",
        "$description": "20px - Medium spacing"
      },
      "6": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$description": "24px - Large spacing"
      },
      "8": {
        "$type": "dimension",
        "$value": "2rem",
        "$description": "32px - Extra large spacing"
      },
      "10": {
        "$type": "dimension",
        "$value": "2.5rem",
        "$description": "40px - Section spacing"
      },
      "12": {
        "$type": "dimension",
        "$value": "3rem",
        "$description": "48px - Large section spacing"
      },
      "16": {
        "$type": "dimension",
        "$value": "4rem",
        "$description": "64px - Page section spacing"
      },
      "20": {
        "$type": "dimension",
        "$value": "5rem",
        "$description": "80px - Hero section spacing"
      },
      "24": {
        "$type": "dimension",
        "$value": "6rem",
        "$description": "96px - Maximum spacing"
      }
    },
    "borderRadius": {
      "none": {
        "$type": "dimension",
        "$value": "0",
        "$description": "No rounding"
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.25rem",
        "$description": "4px - Small radius"
      },
      "base": {
        "$type": "dimension",
        "$value": "0.5rem",
        "$description": "8px - Default radius"
      },
      "md": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$description": "12px - Medium radius"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "16px - Large radius"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.25rem",
        "$description": "20px - Extra large radius"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$description": "24px - Hero element radius"
      },
      "full": {
        "$type": "dimension",
        "$value": "9999px",
        "$description": "Fully rounded - Pills, circles"
      }
    },
    "shadows": {
      "none": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0",
          "offsetY": "0",
          "blur": "0",
          "spread": "0",
          "color": "transparent"
        },
        "$description": "No shadow"
      },
      "sm": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0",
          "color": "rgba(0, 0, 0, 0.12)"
        },
        "$description": "Small shadow - Subtle elevation"
      },
      "md": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "0",
          "color": "rgba(0, 0, 0, 0.16)"
        },
        "$description": "Medium shadow - Card elevation"
      },
      "lg": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0",
          "offsetY": "8px",
          "blur": "16px",
          "spread": "0",
          "color": "rgba(0, 0, 0, 0.24)"
        },
        "$description": "Large shadow - Modal elevation"
      },
      "xl": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0",
          "offsetY": "12px",
          "blur": "24px",
          "spread": "0",
          "color": "rgba(0, 0, 0, 0.32)"
        },
        "$description": "Extra large shadow - Popover elevation"
      },
      "glow": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0",
          "offsetY": "0",
          "blur": "20px",
          "spread": "0",
          "color": "rgba(0, 255, 65, 0.5)"
        },
        "$description": "Neon glow effect - Primary brand"
      },
      "glow-lg": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0",
          "offsetY": "0",
          "blur": "40px",
          "spread": "0",
          "color": "rgba(0, 255, 65, 0.6)"
        },
        "$description": "Large neon glow - Hover states"
      },
      "inner-glow": {
        "$type": "shadow",
        "$value": {
          "offsetX": "0",
          "offsetY": "0",
          "blur": "20px",
          "spread": "0",
          "color": "rgba(0, 255, 65, 0.1)",
          "inset": true
        },
        "$description": "Inner glow - Active states"
      }
    }
  }
}
